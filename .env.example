# Stage 1: Trend Research
SERPAPI_API_KEY=your_serpapi_key_here

# Stage 2 & 3: LLM — Title + Script Generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stage 4: HeyGen — AI Avatar Video
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_AVATAR_ID=your_hp_trt_avatar_id_here
HEYGEN_VOICE_ID=your_hp_trt_voice_id_here

# Stage 5: Submagic — Captions & B-Roll
SUBMAGIC_API_KEY=your_submagic_api_key_here

# Stage 6: YouTube Data API v3 (OAuth 2.0)
YOUTUBE_CLIENT_ID=your_google_oauth_client_id_here
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here
YOUTUBE_CHANNEL_ID=your_hp_trt_channel_id_here

# Operational Config
TIMEZONE=America/New_York
PUBLISH_HOUR=9
MAX_RETRIES=3
LOG_FILE=pipeline_log.jsonl
TOPIC_LOG_FILE=used_topics.json
