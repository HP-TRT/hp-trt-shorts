# Anthropic
ANTHROPIC_API_KEY=your_key_here

# Google / YouTube
GOOGLE_TRENDS_API_KEY=your_key_here
YOUTUBE_CLIENT_ID=your_key_here
YOUTUBE_CLIENT_SECRET=your_key_here
YOUTUBE_REFRESH_TOKEN=your_key_here
YOUTUBE_CHANNEL_ID=your_channel_id

# HeyGen
HEYGEN_API_KEY=your_key_here
HEYGEN_AVATAR_ID=your_avatar_id
HEYGEN_VOICE_ID=your_voice_id

# Submagic
SUBMAGIC_API_KEY=your_key_here

# SerpAPI (for Google/YouTube search trend data)
SERPAPI_KEY=your_key_here

# Settings
POST_TIME_HOUR=9
POST_TIME_MINUTE=0
POST_TIMEZONE=America/Chicago
